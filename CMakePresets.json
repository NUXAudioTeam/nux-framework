{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "cacheVariables": { "NXF_BUILD_TESTS": "ON", "NXF_BUILD_EXAMPLES": "ON" }
    },
    {
      "name": "linux-dev",
      "displayName": "Linux development (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "NXF_BUILD_TESTS": "ON",
        "NXF_BUILD_EXAMPLES": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-release", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "linux-dev", "configurePreset": "linux-dev" }
  ],
  "testPresets": [
    { "name": "windows-x64-release", "configurePreset": "windows-x64", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "linux-dev", "configurePreset": "linux-dev", "output": { "outputOnFailure": true } }
  ]
}
